{
  "name": "bughive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:accuracy": "node --test tests/*.test.mjs",
    "test:fetch": "python3 -m unittest tests/test_report_fetch.py",
    "test": "node --test tests/*.test.mjs && python3 -m unittest tests/test_report_fetch.py",
    "fetch": "python3 intelligence/fetch-h1-reports.py",
    "seed": "node scripts/init-skills.js",
    "verify": "node scripts/verify.js",
    "package": "bash scripts/package.sh",
    "postinstall": "echo 'Run: npx playwright install chromium   (needed once for recon phase 11-flow-mapping)'"
  },
  "dependencies": {
    "playwright": "^1.63.0",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
