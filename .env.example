# Optional: HackerOne API token (recommended)
# Get one at: https://hackerone.com/settings/api_token/edit
H1_API_USERNAME=
H1_API_TOKEN=

# Optional: webhook for budget alerts
BOUNTY_ALERT_WEBHOOK=

# Optional: multi-domain tranche runner. Unset values use scripts/pipeline/data/batch-defaults.json.
# BUGHIVE_BATCH=auto when unset (on when registrable domains exceed the batch size, or live hosts exceed the cap).
# BUGHIVE_BATCH=0
# BUGHIVE_BATCH_DOMAINS=5
# BUGHIVE_TRANCHE_HOST_CAP=40
# BUGHIVE_PASSIVE_URL_CAP=1500
# BUGHIVE_JS_FETCH_CAP=50
# BUGHIVE_HTTPX_THREADS=50
# BUGHIVE_HTTPX_RATE=150
# BUGHIVE_HTTPX_BUDGET_SECONDS=300
# BUGHIVE_KATANA_BUDGET_SECONDS=900
# BUGHIVE_NAABU_BUDGET_SECONDS=600
# BUGHIVE_NUCLEI_BUDGET_SECONDS=1200
# BUGHIVE_GAU_BUDGET_SECONDS=300
# BUGHIVE_RECON_MAX_SECONDS=1200
